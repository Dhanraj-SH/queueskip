NODE_ENV=development
PORT=3000
# Replace these placeholders with separate random values before use.
JWT_ACCESS_SECRET=dev-only-change-me-access-secret
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret
ADMIN_EMAIL=admin@queueskip.local
COOKIE_SAME_SITE=none
COOKIE_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/queueskip?replicaSet=rs0
REDIS_CRITICAL_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@queueskip.local